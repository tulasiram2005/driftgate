generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  memberships  Member[]
  sessions     Session[]
}

model Session {
  id         String @id
  userId     String
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

enum Role {
  ADMIN
  QA
  DEVELOPER
  APPROVER
}

model Project {
  id           String @id @default(cuid())
  name         String
  description  String @default("")
  createdAt    DateTime @default(now())
  members      Member[]
  requirements Requirement[]
  cases        TestCase[]
  suites       Suite[]
  runs         Run[]
  snapshots    EnvironmentSnapshot[]
  comparisons  EnvironmentComparison[]
  visualBaselines VisualBaseline[]
  visualComparisons VisualComparison[]
}

model VisualComparison {
  id String @id @default(cuid())
  projectId String
  baselineId String
  evidenceId String
  createdBy String
  createdAt DateTime @default(now())
  width Int
  height Int
  changedPixels Int
  comparedPixels Int
  diffKey String @unique
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  baseline VisualBaseline @relation(fields: [baselineId], references: [id], onDelete: Restrict)
  @@index([projectId, id])
}

model VisualBaseline {
  comparisons VisualComparison[]
  active Boolean @default(false)
  activatedBy String?
  activatedAt DateTime?
  id String @id @default(cuid())
  projectId String
  evidenceId String
  label String
  environment String
  browser String
  device String
  checkId String
  viewportWidth Int
  viewportHeight Int
  status String @default("PENDING")
  createdBy String
  createdAt DateTime @default(now())
  reviewedBy String?
  reviewedAt DateTime?
  reviewComment String?
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  @@unique([projectId, evidenceId])
  @@index([projectId, id])
}

model EnvironmentComparison {
  id String @id @default(cuid())
  projectId String
  beforeId String
  afterId String
  source String @default("MANUAL_IMPORT")
  createdBy String
  createdAt DateTime @default(now())
  findingCount Int
  findings Json
  expectedRules Json @default("[]")
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, id])
}

model EnvironmentSnapshot {
  id String @id @default(cuid())
  projectId String
  label String
  environment String
  source String @default("MANUAL_IMPORT")
  createdBy String
  runId String?
  browser String?
  device String?
  run Run? @relation(fields: [runId], references: [id], onDelete: Cascade)
  snapshot Json
  createdAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, id])
  @@unique([runId, browser, device])
}

model Member {
  projectId String
  userId    String
  role      Role
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([projectId, userId])
  @@index([userId])
}

model Requirement {
  id          String @id @default(cuid())
  projectId   String
  title       String
  description String @default("")
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cases       TestCase[]
  @@index([projectId, id])
}

model TestCase {
  id            String @id @default(cuid())
  projectId     String
  requirementId String?
  title         String
  description   String @default("")
  priority      String
  type          String
  tags          String[]
  steps         TestStep[]
  suiteCases    SuiteCase[]
  version       Int @default(1)
  archived      Boolean @default(false)
  createdAt     DateTime @default(now())
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement   Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  versions      CaseVersion[]
  @@index([projectId, archived, id])
}

model TestStep {
  caseId   String
  position Int
  action   String
  expected String
  testCase TestCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  @@id([caseId, position])
}

model SuiteCase {
  suiteId String
  caseId String
  position Int
  suite Suite @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  testCase TestCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  @@id([suiteId, caseId])
  @@unique([suiteId, position])
  @@index([caseId])
}

model CaseVersion {
  id       String @id @default(cuid())
  caseId   String
  version  Int
  snapshot Json
  createdAt DateTime @default(now())
  testCase TestCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  @@unique([caseId, version])
}

model Suite {
  id        String @id @default(cuid())
  projectId String
  name      String
  members   SuiteCase[]
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs      Run[]
  @@index([projectId, id])
}

model Run {
  id          String @id @default(cuid())
  projectId   String
  createdBy   String?
  snapshots   EnvironmentSnapshot[]
  suiteId     String?
  environment String
  browser     String
  device      String
  createdAt   DateTime @default(now())
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suite       Suite? @relation(fields: [suiteId], references: [id])
  results     Result[]
  mode        String @default("MANUAL")
  status      String @default("PENDING")
  dispatch    String @default("LOCAL")
  idempotencyKey String?
  requestHash String?
  outbox      DispatchOutbox?
  events      RunEvent[]
  receipts    CallbackReceipt[]
  @@unique([projectId, idempotencyKey])
  @@index([projectId, createdAt])
}

model Result {
  id      String @id @default(cuid())
  runId   String
  caseId  String
  title   String
  version Int
  steps   Json
  status  String @default("NOT_RUN")
  notes   String @default("")
  browser String @default("Chromium")
  device String @default("Desktop")
  flaky Boolean @default(false)
  attempts ResultAttempt[]
  evidence Evidence[]
  run     Run @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@unique([runId, caseId, browser, device])
}

model ResultAttempt {
  id String @id @default(cuid())
  resultId String
  number Int
  status String
  durationMs Int
  error String @default("")
  createdAt DateTime @default(now())
  result Result @relation(fields: [resultId], references: [id], onDelete: Cascade)
  @@unique([resultId, number])
}

model Evidence {
  baselines VisualBaseline[]
  id String @id @default(cuid())
  resultId String
  key String @unique
  kind String
  contentType String
  sizeBytes Int
  ready Boolean @default(false)
  createdAt DateTime @default(now())
  result Result @relation(fields: [resultId], references: [id], onDelete: Cascade)
  @@index([resultId, id])
}

model DispatchOutbox {
  id String @id @default(cuid())
  runId String @unique
  payload Json
  status String @default("PENDING")
  attempts Int @default(0)
  availableAt DateTime @default(now())
  leaseUntil DateTime?
  lastError String?
  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@index([status, availableAt])
}

model CallbackReceipt {
  id String @id
  bodyHash String
  runId String
  receivedAt DateTime @default(now())
  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@index([runId])
}

model RunEvent {
  id Int @id @default(autoincrement())
  runId String
  data Json
  createdAt DateTime @default(now())
  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@index([runId, id])
}
