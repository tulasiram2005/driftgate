generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  memberships  Member[]
  sessions     Session[]
}

model Session {
  id         String @id
  userId     String
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

enum Role {
  ADMIN
  QA
  DEVELOPER
  APPROVER
}

model Project {
  id           String @id @default(cuid())
  name         String
  description  String @default("")
  createdAt    DateTime @default(now())
  members      Member[]
  requirements Requirement[]
  cases        TestCase[]
  suites       Suite[]
  runs         Run[]
}

model Member {
  projectId String
  userId    String
  role      Role
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([projectId, userId])
  @@index([userId])
}

model Requirement {
  id          String @id @default(cuid())
  projectId   String
  title       String
  description String @default("")
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cases       TestCase[]
  @@index([projectId, id])
}

model TestCase {
  id            String @id @default(cuid())
  projectId     String
  requirementId String?
  title         String
  description   String @default("")
  priority      String
  type          String
  tags          String[]
  steps         Json
  version       Int @default(1)
  archived      Boolean @default(false)
  createdAt     DateTime @default(now())
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement   Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  versions      CaseVersion[]
  @@index([projectId, archived, id])
}

model CaseVersion {
  id       String @id @default(cuid())
  caseId   String
  version  Int
  snapshot Json
  createdAt DateTime @default(now())
  testCase TestCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  @@unique([caseId, version])
}

model Suite {
  id        String @id @default(cuid())
  projectId String
  name      String
  caseIds   String[]
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs      Run[]
  @@index([projectId, id])
}

model Run {
  id          String @id @default(cuid())
  projectId   String
  suiteId     String
  environment String
  browser     String
  device      String
  createdAt   DateTime @default(now())
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suite       Suite @relation(fields: [suiteId], references: [id])
  results     Result[]
  @@index([projectId, createdAt])
}

model Result {
  id      String @id @default(cuid())
  runId   String
  caseId  String
  title   String
  version Int
  steps   Json
  status  String @default("NOT_RUN")
  notes   String @default("")
  run     Run @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@unique([runId, caseId])
}
