{
  "name": "@driftgate/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DriftGate authentication, projects, test management and manual execution API.",
  "scripts": {
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint src",
    "build": "pnpm --filter @driftgate/drift build && prisma generate && tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "test": "prisma generate && vitest run",
    "test:storage": "tsx integration/storage.ts",
    "check:sql": "tsx src/sql-check-cli.ts",
    "jira:rotate-key": "tsx --env-file-if-exists=.env src/jira-key-rotation-cli.ts",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@driftgate/drift": "workspace:*",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "bullmq": "^5.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "pdfkit": "0.20.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "swagger-ui-express": "5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/pdfkit": "0.17.7",
    "@types/pngjs": "6.0.5",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "pngjs": "7.0.0",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "tsx": "4.20.6",
    "vitest": "5.0.5"
  }
}
