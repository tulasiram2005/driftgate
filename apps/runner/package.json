{
  "name": "@driftgate/runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fixed Threadline Playwright execution worker",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "build": "pnpm --filter @driftgate/drift build && tsc",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx integration/browser.ts",
    "local:compose": "sh docker/run-local.sh"
  },
  "dependencies": {
    "@driftgate/drift": "workspace:*",
    "@aws-sdk/client-s3": "3.922.0",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "tsx": "4.20.6"
  }
}
