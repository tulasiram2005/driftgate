{
  "name": "driftgate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.19.0 <23",
    "pnpm": "10.18.3"
  },
  "scripts": {
    "preinstall": "node scripts/check-runtime.mjs",
    "prepare": "husky",
    "dev": "turbo run dev --filter=./apps/web",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "lint": "pnpm format:check && pnpm lint:tooling && turbo run lint",
    "lint:tooling": "eslint scripts eslint.config.mjs lint-staged.config.mjs vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:tooling && turbo run test",
    "test:tooling": "vitest run --coverage",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "build": "turbo run build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
